{
  "schemaVersion": 1,
  "minimum": {
    "sillytavern": "1.14.0",
    "tavernHelper": null
  },
  "requirements": [
    {
      "id": "st-context",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext",
      "required": true,
      "fallback": null
    },
    {
      "id": "st-set-extension-prompt",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().setExtensionPrompt",
      "required": false,
      "fallback": "Falls back to TavernHelper.injectPrompts (if present) or manifest generate_interceptor without double injection."
    },
    {
      "id": "tavern-helper-inject-prompts",
      "owner": "tavern-helper",
      "symbol": "TavernHelper.injectPrompts",
      "required": false,
      "fallback": "Uses SillyTavern.getContext().setExtensionPrompt or manifest generate_interceptor."
    },
    {
      "id": "tt-extension-store",
      "owner": "provider",
      "symbol": "window.__TAURITAVERN__.api.extension.store",
      "required": false,
      "fallback": "Falls back to SillyTavern.libs.localforage or extensionSettings on standard SillyTavern hosts."
    },
    {
      "id": "st-localforage",
      "owner": "sillytavern",
      "symbol": "SillyTavern.libs.localforage",
      "required": false,
      "fallback": "Falls back to SillyTavern extensionSettings with saveSettingsDebounced."
    },
    {
      "id": "acu-database-api",
      "owner": "provider",
      "symbol": "window.AutoCardUpdaterAPI",
      "required": false,
      "fallback": "Supports offline TavernDB_checkpoint JSON upload for export and chat-scoped prompt injection for chats without the database plugin."
    }
  ]
}
